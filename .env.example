# Example environment overrides for workday-scraper-api.
# Copy this file to .env for local development and adjust values as needed.

# Path to the SQLite database file.
JOBS_DB_PATH=./jobs.db

# SQLite connection timeout in seconds.
SQLITE_TIMEOUT=10

# Application logging configuration.
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Scraper behavior.
SCRAPE_LIMIT=20
FACET_LIMIT=1
INSTITUTIONS_CONFIG_PATH=./app/scraper_pkg/config/institutions.yaml
SCRAPER_USER_AGENT=Mozilla/5.0
SCRAPER_LISTING_DELAY_SECONDS=0.1
SCRAPER_DETAIL_DELAY_SECONDS=0.5
# Per-request connect/read timeouts and bounded retry policy for listing APIs.
SCRAPER_CONNECT_TIMEOUT_SECONDS=5
SCRAPER_READ_TIMEOUT_SECONDS=30
SCRAPER_MAX_RETRIES=2
SCRAPER_RETRY_BACKOFF_SECONDS=0.5
SCRAPER_RETRY_JITTER_SECONDS=0.1
SCRAPER_MAX_RETRY_DELAY_SECONDS=30
# Maximum facet/listing HTTP attempts allowed per institution collection.
SCRAPER_REQUEST_BUDGET=100

# API server settings.
API_HOST=127.0.0.1
API_PORT=5000
APP_DEBUG=true
