# Example environment overrides for workday-scraper-api.
# Copy this file to .env for local development and adjust values as needed.

# Path to the SQLite database file.
JOBS_DB_PATH=./jobs.db

# SQLite connection timeout in seconds.
SQLITE_TIMEOUT=10

# Application logging configuration.
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Scraper behavior.
SCRAPE_LIMIT=20
FACET_LIMIT=1
INSTITUTIONS_CONFIG_PATH=./app/scraper_pkg/config/institutions.yaml
SCRAPER_USER_AGENT=Mozilla/5.0
SCRAPER_LISTING_DELAY_SECONDS=0.1
SCRAPER_DETAIL_DELAY_SECONDS=0.5

# API server settings.
API_HOST=127.0.0.1
API_PORT=5000
APP_DEBUG=true
